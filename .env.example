# Application
APP_NAME=asm-asset-discovery
APP_ENV=development
DEBUG=true

# API
API_PREFIX=/api/v1

# database (PostgreSQL)
# local:  localhost
# Docker compose overrides this to host `db` automatically
DATABASE_URL=postgresql+psycopg://asm:asm@localhost:5432/asm

# JWT
JWT_SECRET_KEY=useStrongerSecret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# created on startup only if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=DummyPassword
ADMIN_FULL_NAME=Platform Admin

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# DNS discovery
DNS_TIMEOUT_SECONDS=5
