# Application
APP_NAME=asm-asset-discovery
APP_ENV=development
DEBUG=true

# API
API_PREFIX=/api

# Database (PostgreSQL) — Docker Compose service hostname is `db`
DATABASE_URL=postgresql+psycopg://asm:asm@db:5432/asm

# Celery / Redis (Compose service hostname is `redis`)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SCAN_MAX_RETRIES=3
SCAN_RETRY_BACKOFF_SECONDS=2

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bootstrap admin (created on startup only if no ADMIN exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_FULL_NAME=Platform Admin

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# DNS
DNS_TIMEOUT_SECONDS=5

# Login rate limit (in-memory, per client IP)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Set true for pytest (skips Celery recovery on API startup)
# TESTING=true
